          </article>

          <article class="team-member">
            <img
              src="https://convidatasshop.wordpress.com/wp-content/uploads/2026/07/inserir-um-titulo-22.png"
              alt="Lucas, barbeiro da Tefinha Barbearia"
            />
            <div class="team-member-info">
              <h3>Lucas</h3>
              <p>Barbeiro há +X anos</p>
            </div>
          </article>

          <article class="team-member">
            <img
              src="https://convidatasshop.wordpress.com/wp-content/uploads/2026/07/inserir-um-titulo-23.png"
              alt="Maikon, barbeiro da Tefinha Barbearia"
            />
            <div class="team-member-info">
              <h3>Maikon</h3>
              <p>Barbeiro há +X anos</p>
            </div>
          </article>

          <article class="team-member">
            <img
              src="https://convidatasshop.wordpress.com/wp-content/uploads/2026/07/inserir-um-titulo-24.png"
              alt="Fabrício, barbeiro da Tefinha Barbearia"
            />
            <div class="team-member-info">
              <h3>Fabrício</h3>
              <p>Barbeiro há +X anos</p>
            </div>
          </article>
        </div>
      </section>
    </main>

